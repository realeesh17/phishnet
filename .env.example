# Frontend points at the local Azure Functions host. No API credentials are required.
VITE_PHISHNET_API_BASE_URL=http://localhost:7071/api

# Optional integrations remain disabled unless explicitly configured.
OPENPHISH_ENABLED=false
PHISHTANK_API_KEY=

# Optional Azure Functions / Application Insights telemetry connection string.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# API protection. Use Redis storage when running more than one API instance.
PHISHNET_ENV=development
PHISHNET_RATE_LIMIT=30/minute
PHISHNET_RATE_LIMIT_STORAGE_URL=
PHISHNET_MAX_REQUEST_BYTES=16384
PHISHNET_MAX_CONCURRENT_REQUESTS=32
PHISHNET_MAX_CONCURRENT_REQUESTS_PER_CLIENT=4
PHISHNET_TRUSTED_PROXY_CIDRS=
PHISHNET_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver,testclient
PHISHNET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
